ENVIRONMENT=production
PUBLIC_ORIGIN=https://chat.i-tool-chat.store
PORT=3200
DATA_DIRECTORY=/var/lib/ai-tool-chat
FRONTEND_DIRECTORY=/opt/ai-tool-chat/current/frontend
ALLOW_REGISTRATION=false
ALLOW_GUEST_ACCESS=false
MAX_GUEST_SESSIONS=1000
MOCK_MODEL=false
# Store the real key only in a protected environment file, never in Git.
QWEN_API_KEY=
NODE_TASK_CONCURRENCY=2
MAX_CONCURRENT_TASKS=2
MAX_FILE_BYTES=8388608
MAX_USER_FILE_BYTES=67108864
