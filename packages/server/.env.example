ENVIRONMENT=production
PUBLIC_ORIGIN=https://chat.i-tool-chat.store
PORT=3200
DATA_DIRECTORY=/var/lib/ai-tool-chat
FRONTEND_DIRECTORY=/opt/ai-tool-chat/current/frontend
ALLOW_REGISTRATION=false
ALLOW_GUEST_ACCESS=false
MAX_GUEST_SESSIONS=1000
MOCK_MODEL=false
# Store the real key only in a protected environment file, never in Git.
QWEN_API_KEY=
# Optional independent OpenAI-compatible text/file provider. Base URL includes /v1.
# Leave both values empty to retain the existing Bailian provider.
TEXT_API_KEY=
TEXT_API_BASE_URL=
DEFAULT_MODEL=
DEFAULT_FILE_MODEL=
# Agent-only opt-in for providers verified to support thinking: { type: "disabled" }.
AGENT_DISABLE_THINKING=false
# Enable only when the selected text endpoint supports vision.
MULTIMODAL_USE_TEXT_PROVIDER=false
DEFAULT_MULTIMODAL_MODEL=
# User-supplied CNY rates per million tokens, 2026-10-13; estimates are not invoices.
MODEL_PRICES_JSON='{"deepseek-flash":{"inputPerMillion":1,"outputPerMillion":4,"cachedInputPerMillion":0.02,"currency":"CNY"}}'
NODE_TASK_CONCURRENCY=2
MAX_CONCURRENT_TASKS=2
MAX_FILE_BYTES=8388608
MAX_USER_FILE_BYTES=67108864
